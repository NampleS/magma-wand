{
  "manifest_version": 3,
  "name": "Magma Extension",
  "version": "1.1.0",
  "description": "Magma 그림판에 클립 스튜디오·포토샵 기능을 더해 줍니다. 자동으로 최신 버전을 받아요.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://magma.com/*",
    "https://*.magma.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://magma.com/*", "https://*.magma.com/*"],
      "js": ["wand.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
